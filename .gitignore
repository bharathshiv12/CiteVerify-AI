# ==============================================================================
# CiteVerify-AI Monorepo .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Python Virtual Environments & Packages
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
out/
.turbo/
.cache/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example
*.pem
*.key
*.cert

# Runtime Data, Logs & Uploads
uploads/
*.log
logs/
*.sqlite3
*.db

# AI / ML Model Weights, Checkpoints & Datasets (Store in remote storage, not Git)
ai_engine/models/*.pt
ai_engine/models/*.bin
ai_engine/models/*.safetensors
ai_engine/models/*.onnx
ai_engine/models/*.ckpt
ai_engine/models/*.h5
ai_engine/data/raw/
ai_engine/data/processed/
*.tar.gz
*.zip

# IDEs & Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Backend additions (append-only)
backend/.env
backend/uploads/
backend/storage_data/
*.pdf
!tests/fixtures/*.pdf

