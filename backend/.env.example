# ==============================================================================
# Backend (.env.example)
# ==============================================================================

# Server binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS origins (comma-separated, default local frontend only)
CORS_ORIGINS=http://localhost:3000

# Frontend reference URL
FRONTEND_URL=http://localhost:3000

# File uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=../uploads

# Database (Leave empty for default in-memory / SQLite repository; set for PostgreSQL/Supabase)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM & AI Engine settings (consumed by backend calling ai_engine)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Research Services Polite Pool
OPENALEX_EMAIL=researcher@example.com
CROSSREF_EMAIL=researcher@example.com
