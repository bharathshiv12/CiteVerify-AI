# ==============================================================================
# CiteVerify AI — Backend Configuration (.env.example)
# Place real secrets in backend/.env (git-ignored)
# ==============================================================================

# Server binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# CORS and Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# File uploads & storage
MAX_UPLOAD_SIZE_MB=25
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=backend/storage_data
SUPABASE_STORAGE_BUCKET=sapthack-documents

# Persistence Repository Backend ("supabase" for PostgreSQL persistence, "memory" for dev/testing)
REPOSITORY_BACKEND=supabase

# Supabase Auth & PostgreSQL Database (Free Tier)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Primary secret key (Service Role / Secret Key) - NEVER expose to frontend!
SUPABASE_SECRET_KEY=sb_secret_<your-supabase-secret-key>
# Backward-compatibility alias:
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Publishable / Anon Key (Optional on backend, used for public verification fallback)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-supabase-publishable-key>
SUPABASE_ANON_KEY=
# JWT Secret (for offline HS256 validation if asymmetric JWKS is not used)
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres

# Scholarly Research APIs (Free / Polite Pool)
CROSSREF_API_URL=https://api.crossref.org
OPENALEX_API_URL=https://api.openalex.org
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
CONTACT_EMAIL=researcher@example.com
OPENALEX_EMAIL=researcher@example.com
CROSSREF_EMAIL=researcher@example.com

# AI Engine / Verification (Optional: "none" | "gemini" | "groq" | "ollama")
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Rate Limiting
RATE_LIMIT_ENABLED=true
