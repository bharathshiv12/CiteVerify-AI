# ==============================================================================
# AI Engine (.env.example)
# ==============================================================================

# LLM Provider selection: 'gemini', 'openai', or 'local'
LLM_PROVIDER=gemini

# API key for the chosen LLM provider (e.g. Google Gemini API free tier)
LLM_API_KEY=

# Default LLM model identifier
LLM_MODEL=gemini-1.5-flash

# Local embedding model name (e.g. sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Maximum generation tokens and timeout settings
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
