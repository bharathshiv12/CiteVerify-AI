# ==============================================================================
# CiteVerify AI — Frontend Local Environment Template (.env.local.example)
# Copy this file to frontend/.env.local and populate with your Supabase credentials.
# NEVER commit .env.local to version control!
# ==============================================================================

# FastAPI Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Synthetic Mock Payload Toggle (false = use live backend, true = use mock fixtures)
NEXT_PUBLIC_USE_MOCKS=false

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client bundle)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
# Legacy/alternative naming:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Maximum upload file size in Megabytes (default 25)
NEXT_PUBLIC_MAX_UPLOAD_MB=25
