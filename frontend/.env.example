# ==============================================================================
# Frontend (.env.example)
# ==============================================================================
# Only NEXT_PUBLIC_* variables are exposed to the browser client bundle.
# NEVER place backend service keys or LLM API keys in frontend env!

# Base URL of the CiteVerify FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Synthetic mock payload toggle: set to 'true' during isolated UI development to
# load synthetic fixtures with a visible SAMPLE DATA banner. Must be 'false' for live demo.
NEXT_PUBLIC_USE_MOCKS=false

# Optional Supabase credentials for client-side authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Maximum upload file size in Megabytes (default 25)
NEXT_PUBLIC_MAX_UPLOAD_MB=25
