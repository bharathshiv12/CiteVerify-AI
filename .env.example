# ==============================================================================
# CiteVerify-AI Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local orchestration or populate individual component envs.
# NEVER commit real credentials or .env files to source control.

# --- Backend Server Configuration ---
# Host interface for FastAPI server (0.0.0.0 for container/all interfaces, 127.0.0.1 for local loopback)
BACKEND_HOST=127.0.0.1
# Port for FastAPI server
BACKEND_PORT=8000
# Base URL where frontend can reach the backend (used in frontend client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated list of allowed origins for CORS. Default local dev: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# URL of frontend application for redirect / reference
FRONTEND_URL=http://localhost:3000

# --- File Storage & Uploads ---
# Maximum PDF upload size in megabytes
MAX_UPLOAD_SIZE_MB=25
# Local directory path where uploaded PDFs are stored during processing
UPLOAD_DIR=uploads

# --- Database & Persistence ---
# Database connection string. Leave blank or empty to use local in-memory/SQLite repository interface
DATABASE_URL=
# Supabase project URL (optional for MVP; used if migrating beyond in-memory/SQLite)
SUPABASE_URL=
# Supabase public anonymous client key (safe for browser if auth enabled)
SUPABASE_ANON_KEY=
# Supabase private service role key (backend only, NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Engine & LLM Provider ---
# LLM Provider name: gemini, openai, or local
LLM_PROVIDER=gemini
# LLM API key (e.g. Google AI Studio Gemini API free tier key). Backend/AI engine only.
LLM_API_KEY=
# LLM model identifier (e.g. gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini)
LLM_MODEL=gemini-1.5-flash
# Embedding model name or HuggingFace path (e.g. all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Research Services Polite Pools ---
# Email address sent in User-Agent to OpenAlex for polite pool access (faster rate limits, ₹0)
OPENALEX_EMAIL=researcher@example.com
# Email address sent in Crossref queries for polite pool rate limiting (₹0)
CROSSREF_EMAIL=researcher@example.com

# --- Frontend Testing & Mocks ---
# Set to 'true' to load synthetic fixture payloads from contracts/examples/ with a visible SAMPLE DATA banner.
# Must be 'false' in production and evaluation demos.
NEXT_PUBLIC_USE_MOCKS=false
